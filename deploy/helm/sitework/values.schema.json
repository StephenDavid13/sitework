{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sitework chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry": {
          "description": "Registry host prefixed to each repository; empty uses the repository as-is.",
          "type": "string",
          "pattern": "^([a-zA-Z0-9.-]+(:[0-9]+)?(/[a-zA-Z0-9._-]+)*/?)?$"
        },
        "tag": {
          "description": "Image tag for both images; empty means the chart appVersion. A string: pass it with --set-string so an all-digit tag is not read as a number.",
          "type": "string",
          "pattern": "^([a-zA-Z0-9_][a-zA-Z0-9._-]{0,127})?$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "api": {
      "$ref": "#/$defs/component",
      "unevaluatedProperties": false,
      "properties": {
        "environment": {
          "description": "ASPNETCORE_ENVIRONMENT.",
          "type": "string",
          "minLength": 1
        },
        "trustedProxyNetworks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cidr"
          },
          "uniqueItems": true
        },
        "rateLimiting": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requestsPerMinute": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "writesPerMinute": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          }
        },
        "telemetry": {
          "type": "object",
          "additionalProperties": false,
          "description": "OpenTelemetry export. Traces and metrics go to this OTLP endpoint when set.",
          "properties": {
            "otlpEndpoint": {
              "type": "string"
            },
            "otlpProtocol": {
              "type": "string",
              "enum": [
                "grpc",
                "http/protobuf"
              ]
            },
            "resourceAttributes": {
              "type": "string"
            }
          }
        }
      }
    },
    "web": {
      "$ref": "#/$defs/component",
      "unevaluatedProperties": false
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "host": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*)?$"
        },
        "publicUrl": {
          "type": "string",
          "pattern": "^(https?://[^/\\s]+)?$"
        },
        "certificateArn": {
          "type": "string",
          "pattern": "^(arn:aws[a-z-]*:acm:[a-z0-9-]+:[0-9]{12}:certificate/[a-zA-Z0-9-]+)?$"
        },
        "externalDns": {
          "type": "boolean"
        },
        "inboundCidrs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cidr"
          },
          "uniqueItems": true
        },
        "apiPaths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^/[^/].*$"
          },
          "uniqueItems": true
        },
        "annotations": {
          "$ref": "#/$defs/stringMap"
        },
        "wafAclArn": {
          "type": "string",
          "pattern": "^(arn:aws[a-z-]*:wafv2:[a-z0-9-]+:[0-9]{12}:regional/webacl/[A-Za-z0-9_-]+/[a-f0-9-]+)?$"
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sslMode": {
          "enum": [
            "Disable",
            "Allow",
            "Prefer",
            "Require",
            "VerifyCA",
            "VerifyFull"
          ]
        },
        "existingSecret": {
          "type": "string"
        },
        "externalSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "secretArn": {
              "type": "string"
            },
            "region": {
              "type": "string",
              "pattern": "^([a-z]{2}(-[a-z]+)+-[0-9])?$"
            },
            "refreshInterval": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|\u00b5s|ms|s|m|h))+$"
            }
          },
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "properties": {
              "secretArn": {
                "minLength": 1
              },
              "region": {
                "minLength": 1
              }
            },
            "required": [
              "secretArn",
              "region"
            ]
          }
        }
      }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "seedDemoData": {
          "type": "boolean"
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 30
        },
        "resources": {
          "$ref": "#/$defs/resources"
        }
      }
    }
  },
  "$defs": {
    "cidr": {
      "type": "string",
      "pattern": "^([0-9]{1,3}(\\.[0-9]{1,3}){3}/[0-9]{1,2}|[0-9a-fA-F:]+/[0-9]{1,3})$"
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "$ref": "#/$defs/resourceList"
        },
        "limits": {
          "$ref": "#/$defs/resourceList"
        }
      }
    },
    "resourceList": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "integer",
          "number"
        ]
      }
    },
    "component": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "autoscaling": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "targetCPUUtilizationPercentage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "pdb": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxUnavailable": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "string",
                  "pattern": "^[0-9]+%$"
                }
              ]
            }
          }
        },
        "preStopSleepSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "annotations": {
              "$ref": "#/$defs/stringMap"
            }
          }
        },
        "serviceAccount": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "create": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            },
            "annotations": {
              "$ref": "#/$defs/stringMap"
            }
          }
        },
        "podAnnotations": {
          "$ref": "#/$defs/stringMap"
        },
        "podLabels": {
          "$ref": "#/$defs/stringMap"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "securityContext": {
          "type": "object"
        },
        "nodeSelector": {
          "$ref": "#/$defs/stringMap"
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "affinity": {
          "type": "object"
        }
      }
    }
  }
}
