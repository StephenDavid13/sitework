    "cn": "^0.4.0",
    "lucide-react": "^1.56.0",
    "maplibre-gl": "^6.14.0",
    "next": "16.4.0",
    "nuqs": "^2.10.2",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
